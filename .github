name: CI/CD Pipeline

on:
  push:
    branches: [ "main" ]
  pull_request:
    branches: [ "main" ]

# किए जाने वाले कार्य (Jobs)
jobs:
  build-and-test:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    - name: Run a One-Line Script
      run: echo "Code checked out successfully!"

    - name: Run a Multi-Line Script
      run: |
        echo "Running tests..."
        echo "Deploying application..."

